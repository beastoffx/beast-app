# ==============================================================================
# B.E.A.S.T ACADEMY Production Environment Configuration Template
# NOTE: Never commit production credentials, secrets, or API keys to git.
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Server Network & Security Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://beastacademy.edu

# JWT Authentication
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Local Database (Default: SQLite in WAL Mode)
DB_PATH=./data/beast_academy.db

# Supabase Central PostgreSQL (Target Production Database)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage & Cloud Services (Target Production Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_backend_only
SUPABASE_RESOURCES_BUCKET=beast-resources
SUPABASE_DOUBTS_BUCKET=beast-doubts

# Google OAuth Configuration (Google Cloud Console)
GOOGLE_CLIENT_ID_WEB=your_web_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=com.beastacademy.beast_academy

# Email Verification / OTP Provider
# Supported: 'console' (for local testing/dev, logs code to terminal), 'smtp' (production Gmail SMTP)
EMAIL_PROVIDER=smtp
EMAIL_OTP_TTL_MINUTES=10
EMAIL_FROM=B.E.A.S.T. Academy <beastiankankinara2026@gmail.com>

# Production Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=beastiankankinara2026@gmail.com
SMTP_PASSWORD=
